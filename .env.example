DATABASE_URL=file:./data/berlin-reunion.db
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_APP_URL=http://localhost:3050
BETTER_AUTH_SECRET=your-secret-here
EMAIL_FROM=Berlin Reunion <noreply@yourdomain.com>

# Rate limiting (optional — defaults shown)
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=10

# Field encryption — required (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=
BLIND_INDEX_KEY=

# Google Maps (optional — enables map views and location autocomplete)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
